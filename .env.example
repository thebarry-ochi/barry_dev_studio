# Set the real public origin before deployment. Leave unset for local development.
# SITE_URL=https://your-domain.example
# Enable only after the real homepage is ready for search engines.
SITE_INDEXABLE=false

# Optional public destinations (HTTPS only).
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_ROM_AFRICA_URL=
NEXT_PUBLIC_RIDGEVIEW_URL=
NEXT_PUBLIC_CARLUX_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
# Server-only authenticated delivery webhook; do not prefix with NEXT_PUBLIC_.
# It receives JSON {name, company, website, email, message} with Bearer auth.
CONTACT_DELIVERY_URL=
CONTACT_DELIVERY_TOKEN=
